{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.symbols",
      "**/*.js.map"
    ],
    "cleanUrls": true,
    "redirects": [
      {
        "//": "In-app legal routes have real, crawlable pages of their own. Send them there rather than into the canvas app, where the same text exists but Google cannot read it.",
        "source": "/legal/privacy",
        "destination": "/privacy-policy",
        "type": 301
      },
      {
        "source": "/legal/terms",
        "destination": "/terms",
        "type": 301
      },
      {
        "source": "/legal/support",
        "destination": "/support",
        "type": 301
      },
      {
        "source": "/legal/data-deletion",
        "destination": "/data-deletion",
        "type": 301
      },
      {
        "//": "Every path the SPA used to be served at. It never actually restored these routes -- onGenerateInitialRoutes in lib/app.dart discards the incoming URL and always boots AuthWrapper -- so a 301 to /app preserves the only behaviour these URLs ever had, while letting everything else 404 honestly instead of returning a soft-404 copy of the homepage.",
        "regex": "^/(activity-timeline|audit-log|batches|billing|bulk|categories|company-switcher|customers|dashboard|excel|favorites|forecast|help|home|landing|legal|login|notifications|onboarding|orders|pos|price-history|products|profile|register|reorder-suggestions|reports|returns|roles|scanner|search|settings|stock|stock-take|super-admin|transactions|users|vendors|warehouse-zones)(/.*)?$",
        "destination": "/app",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "//": "The app shell is app.html, served at /app by cleanUrls. This rewrite only covers path-style deep links beneath it; the app routes on the URL fragment, so the server normally never sees them.",
        "source": "/app/**",
        "destination": "/app.html"
      }
    ],
    "headers": [
      {
        "//": "Firebase applies every matching rule and the LAST one wins, so this is the default and everything below is an override. Matching is on the request path, not the file on disk, which is why the app rule below says /app and not /app.html.",
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "//": "Content-hashed by seo/build.mjs, so a year is safe. Must come after /static/** to win.",
        "source": "/static/site.*.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/robots.txt",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "/app",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/flutter_service_worker.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/flutter_bootstrap.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.js.map",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "**/*.@(ttf|otf|woff|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.wasm",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/icons/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/canvaskit/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "stockmanagement-27af8",
          "configurations": {
            "web": "1:647731796550:web:1ec5e3fe665c1293ec0847"
          }
        }
      }
    }
  }
}
