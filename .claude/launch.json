{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-debug",
      "runtimeExecutable": "flutter",
      "runtimeArgs": [
        "run",
        "-d",
        "web-server",
        "--web-port=8080",
        "--web-hostname=127.0.0.1"
      ],
      "port": 8080
    },
    {
      "name": "web-release",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8081",
        "--directory",
        "build/web"
      ],
      "port": 8081
    }
  ]
}