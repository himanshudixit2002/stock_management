rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && userDocExists() &&
        (getUserData().role == 'admin' || getUserData().role == 'owner');
    }

    function belongsToCompany(companyId) {
      return isAuthenticated() && userDocExists() && getUserData().companyId == companyId;
    }

    // Multi-company: read company docs for any workspace the user is a member of (up to 50).
    function hasMembershipForCompany(companyId) {
      let m = getUserData().companyMemberships;
      return m is list && (
        (m.size() > 0 && m[0].companyId == companyId) ||
        (m.size() > 1 && m[1].companyId == companyId) ||
        (m.size() > 2 && m[2].companyId == companyId) ||
        (m.size() > 3 && m[3].companyId == companyId) ||
        (m.size() > 4 && m[4].companyId == companyId) ||
        (m.size() > 5 && m[5].companyId == companyId) ||
        (m.size() > 6 && m[6].companyId == companyId) ||
        (m.size() > 7 && m[7].companyId == companyId) ||
        (m.size() > 8 && m[8].companyId == companyId) ||
        (m.size() > 9 && m[9].companyId == companyId) ||
        (m.size() > 10 && m[10].companyId == companyId) ||
        (m.size() > 11 && m[11].companyId == companyId) ||
        (m.size() > 12 && m[12].companyId == companyId) ||
        (m.size() > 13 && m[13].companyId == companyId) ||
        (m.size() > 14 && m[14].companyId == companyId) ||
        (m.size() > 15 && m[15].companyId == companyId) ||
        (m.size() > 16 && m[16].companyId == companyId) ||
        (m.size() > 17 && m[17].companyId == companyId) ||
        (m.size() > 18 && m[18].companyId == companyId) ||
        (m.size() > 19 && m[19].companyId == companyId) ||
        (m.size() > 20 && m[20].companyId == companyId) ||
        (m.size() > 21 && m[21].companyId == companyId) ||
        (m.size() > 22 && m[22].companyId == companyId) ||
        (m.size() > 23 && m[23].companyId == companyId) ||
        (m.size() > 24 && m[24].companyId == companyId) ||
        (m.size() > 25 && m[25].companyId == companyId) ||
        (m.size() > 26 && m[26].companyId == companyId) ||
        (m.size() > 27 && m[27].companyId == companyId) ||
        (m.size() > 28 && m[28].companyId == companyId) ||
        (m.size() > 29 && m[29].companyId == companyId) ||
        (m.size() > 30 && m[30].companyId == companyId) ||
        (m.size() > 31 && m[31].companyId == companyId) ||
        (m.size() > 32 && m[32].companyId == companyId) ||
        (m.size() > 33 && m[33].companyId == companyId) ||
        (m.size() > 34 && m[34].companyId == companyId) ||
        (m.size() > 35 && m[35].companyId == companyId) ||
        (m.size() > 36 && m[36].companyId == companyId) ||
        (m.size() > 37 && m[37].companyId == companyId) ||
        (m.size() > 38 && m[38].companyId == companyId) ||
        (m.size() > 39 && m[39].companyId == companyId) ||
        (m.size() > 40 && m[40].companyId == companyId) ||
        (m.size() > 41 && m[41].companyId == companyId) ||
        (m.size() > 42 && m[42].companyId == companyId) ||
        (m.size() > 43 && m[43].companyId == companyId) ||
        (m.size() > 44 && m[44].companyId == companyId) ||
        (m.size() > 45 && m[45].companyId == companyId) ||
        (m.size() > 46 && m[46].companyId == companyId) ||
        (m.size() > 47 && m[47].companyId == companyId) ||
        (m.size() > 48 && m[48].companyId == companyId) ||
        (m.size() > 49 && m[49].companyId == companyId)
      );
    }

    // Is there a server-verified membership record for this user in
    // [companyId]? Member docs can only be created by naming a join code that
    // really maps to the company, or by the company's own creator — unlike
    // companyMemberships on the user doc, which the client writes about itself.
    function hasMemberDoc(companyId) {
      return exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid));
    }

    // Self-serve profile/workspace updates must not grant privileges.
    //
    // Two things are gated, because together they were a one-step workspace
    // takeover: set role:'admin' on your own doc, which makes isAdmin() true,
    // which unlocks the admin branch of every other rule.
    //
    //  * role may only become privileged for a workspace the company doc says
    //    you created (server-side truth, not a claim). Switching into a
    //    workspace where you are staff/viewer/manager is unaffected.
    //  * roleId must match the member doc — see selfRoleIdIsVerified below.
    //  * companyId may only move to a workspace you hold a member doc for.
    //    companyMemberships is self-written and cannot gate this: forging an
    //    entry would otherwise let you switch into any workspace and read it.
    //
    // Users whose memberships predate member docs keep working on their
    // current workspace (companyId unchanged is always allowed); switching
    // needs scripts/migrate_members.js to have run.
    function selfUserUpdateDoesNotEscalate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let target = request.resource.data.companyId;
      return !changed.hasAny(['email', 'uid', 'createdAt', 'permissions'])
        && (!changed.hasAny(['role'])
            || request.resource.data.role in ['staff', 'viewer', 'manager']
            || (target != '' && isCompanyCreator(target)))
        && (!changed.hasAny(['roleId']) || selfRoleIdIsVerified(target))
        && (target == resource.data.companyId
            || target == ''
            || hasMemberDoc(target));
    }

    // roleId is not a label. hasPermission() resolves the caller's permissions
    // through companies/{cid}/roles/{roleId}, and the seeded owner/admin role
    // docs carry AppPermissions.allTrue() — so pointing your own user doc at
    // one grants every permission in the workspace. That made roleId exactly as
    // powerful as role:'admin', which the clause above already blocks, and it
    // was reachable from a viewer account in a single self-write.
    //
    // The member doc is the server-verified record of what this workspace
    // actually granted you: self-serve joins land on the staff role and only an
    // admin can change one afterwards. So a self-set roleId must match it.
    // Leaving every workspace (companyId '') has no company to verify against,
    // so it may only land on a role that carries no inherent privilege.
    function selfRoleIdIsVerified(target) {
      return target == ''
        ? request.resource.data.get('roleId', '') in ['staff', 'viewer', 'manager', '']
        : (isCompanyCreator(target)
           || (hasMemberDoc(target)
               && memberDocFor(target).get('roleId', '')
                  == request.resource.data.get('roleId', '')));
    }

    function memberDocFor(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid)).data;
    }

    // Super admin allowlist. No client can write /superAdmins, so membership
    // here cannot be self-granted the way companyMemberships could — that is
    // the whole reason this is a separate collection rather than a field.
    // Grant it from the Firebase console or the Admin SDK only.
    function isSuperAdmin() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/superAdmins/$(request.auth.uid));
    }

    // A suspended or deleted workspace stops accepting new data.
    //
    // Applied to writes only, never reads: rules get() calls are billed as
    // document reads and these rules already spend 1-3 per evaluation, so
    // gating reads too would be a large across-the-board cost increase for a
    // control that only needs to stop new data. A suspended tenant keeps read
    // access to its own books and is shown the reason.
    //
    // Absent status means active — every company doc created before this
    // existed has no status field.
    function companyActive(companyId) {
      let company = get(/databases/$(database)/documents/companies/$(companyId)).data;
      return !('status' in company) || company.status == 'active';
    }

    function canReadCompanyDoc(companyId) {
      return isAuthenticated() && userDocExists() &&
        (belongsToCompany(companyId) || hasMembershipForCompany(companyId));
    }

    // Check if the user has a specific permission via their role document
    function hasPermission(companyId, permission) {
      let userData = getUserData();
      let roleId = userData.roleId;
      // Admin/owner bypass: mirror isAdmin() for consistency
      return userData.role == 'admin' || userData.role == 'owner' ||
        (roleId != null && roleId != '' &&
         exists(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)) &&
         get(/databases/$(database)/documents/companies/$(companyId)/roles/$(roleId)).data.permissions[permission] == true) ||
        // Per-user override
        (userData.permissions != null && userData.permissions[permission] == true);
    }

    // Allow the original creator of a company to bootstrap it (seed roles, etc.)
    function isCompanyCreator(companyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/companies/$(companyId)).data.adminUid == request.auth.uid;
    }

    // Fields on a company doc that only a platform admin may write.
    //
    // Without this a company's own admin could update their doc freely, which
    // meant they could lift their own suspension (making the whole suspension
    // control decorative against the exact person it targets), award
    // themselves a paid plan, or hand ownership to someone else.
    function companyPrivilegedFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'statusNote', 'statusChangedAt', 'plan', 'adminUid']);
    }

    // Creator may set/clear permanentJoinCode when their active companyId is another workspace.
    function companyPermanentJoinCodeUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['permanentJoinCode']);
    }

    // Super admin allowlist. Readable only by the subject (so the app can ask
    // "am I one?"), never listable, and never writable from a client.
    match /superAdmins/{uid} {
      allow get: if isAuthenticated() && request.auth.uid == uid;
      allow list: if false;
      allow write: if false;
    }

    // The tier catalog. A price list is public information, and it has to be
    // readable by the signed-out register screen, so this is world-readable by
    // design. Nothing tenant-specific may ever be stored here.
    //
    // Writable only by a platform admin: these documents decide what every
    // workspace is capped at.
    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Marketing configuration for the signed-out screens — the founding-member
    // offer's copy and its advisory counter.
    //
    // World-readable for the same reason as /plans: the register and login
    // screens read it before anyone has authenticated, and the /metadata rule
    // below requires auth. It holds copy and a count and must hold nothing
    // else.
    match /publicConfig/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // What platform admins did, across every tenant.
    //
    // Append-only by construction: a platform admin can write history but never
    // rewrite it, which is the entire point of keeping this separate from the
    // per-company auditLogs a tenant admin can reach.
    match /platformAuditLogs/{logId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // Users collection (root level)
    match /users/{userId} {
      // Platform admins read across tenants. This branch has to live here:
      // users are a ROOT collection, so the companies/{id}/{document=**} grant
      // below structurally cannot reach them. Without it the super admin
      // console's global user list is denied outright and every per-company
      // user count silently reads 0 — the console appeared to show only the
      // admin's own workspace.
      allow read: if isSuperAdmin() ||
        (isAuthenticated() &&
        (request.auth.uid == userId ||
         (userDocExists() && getUserData().companyId == resource.data.companyId)));

      // A user bootstraps their own doc. They may claim a privileged role only
      // for a workspace the company doc already says they created (adminUid is
      // server-side truth, not a client assertion). Everyone else lands as a
      // non-privileged member with no per-user permission overrides.
      allow create: if isAuthenticated() && (
        // Self-bootstrap: a user may create their own doc, but only as a
        // non-privileged member — unless the company doc already names them as
        // its creator, which is server-side truth rather than a claim.
        (request.auth.uid == userId
          && request.resource.data.permissions.size() == 0
          && (request.resource.data.role in ['staff', 'viewer', 'manager']
              || isCompanyCreator(request.resource.data.companyId))
          // A self-created doc may only name a workspace the caller can prove
          // they belong to. Update already required this; create did not, and
          // self-delete is allowed — so deleting your own user doc and
          // re-creating it with someone else's companyId was a complete
          // cross-tenant breach: belongsToCompany() would then pass for a
          // workspace you were never invited to, exposing its products,
          // transactions, customers, invoices and orders. Target ids are not
          // secret; joinCodeIndex hands them to any signed-in caller.
          //
          // '' is the workspace-less state (see leaveCompany), which grants
          // nothing. Registration writes its doc before the member doc exists,
          // so the creator check carries that case.
          && (request.resource.data.companyId == ''
              || hasMemberDoc(request.resource.data.companyId)
              || isCompanyCreator(request.resource.data.companyId)))
        // An admin provisioning a teammate may set any role. AuthService
        // signs back in as the admin before writing, so this is the branch
        // that covers staff creation.
        || (belongsToCompany(request.resource.data.companyId)
            && (isAdmin()
                || hasPermission(request.resource.data.companyId,
                                 'canManageUsers')))
      );

      // isSuperAdmin() here is lifecycle, matching the company doc's own
      // `allow update: if isSuperAdmin()`. Purging a workspace has to detach the
      // people who were in it: without this their user docs kept pointing at a
      // company that no longer exists, and they signed in to an empty,
      // permission-less app with no explanation and no way out.
      allow update: if (isAuthenticated() && request.auth.uid == userId &&
          selfUserUpdateDoesNotEscalate()) ||
        (belongsToCompany(resource.data.companyId) &&
         (isAdmin() || hasPermission(resource.data.companyId, 'canManageUsers'))) ||
        isSuperAdmin();

      allow delete: if (isAuthenticated() && request.auth.uid == userId) ||
        (belongsToCompany(resource.data.companyId) &&
         (isAdmin() || hasPermission(resource.data.companyId, 'canManageUsers'))) ||
        isSuperAdmin();
    }

    // App metadata (e.g. first-user flag)
    // App-wide metadata. isAdmin() is company-agnostic — it only tests the
    // caller's own role field — so gating writes on it let ANY tenant's admin
    // write global state. Nothing in the app writes here, so platform admins
    // only.
    match /metadata/{docId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    // Notifications (created by Cloud Functions, read by recipients)
    match /notifications/{notifId} {
      allow read: if isAuthenticated() &&
        resource.data.recipientUid == request.auth.uid;
      allow update: if isAuthenticated() &&
        resource.data.recipientUid == request.auth.uid;
      allow delete: if isAuthenticated() &&
        resource.data.recipientUid == request.auth.uid;
      allow create: if false;
    }

    // Permanent join code lookup (6-char doc id). Anyone signed in can read for join flow.
    match /joinCodeIndex/{code} {
      allow get: if isAuthenticated();
      allow list: if false;
      // Publishing a code for your OWN workspace only. Widened from
      // creator-only to any admin so invite codes can be indexed here too:
      // joinCompany's collectionGroup('invites') query has no matching rule and
      // always failed, which broke every join. An admin who can invite people
      // can already publish the workspace's permanent code, so this grants
      // nothing new — and the entry still names a company they belong to.
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasAll(['companyId', 'companyName']) &&
        request.resource.data.companyId is string &&
        request.resource.data.companyName is string &&
        exists(/databases/$(database)/documents/companies/$(request.resource.data.companyId)) &&
        (get(/databases/$(database)/documents/companies/$(request.resource.data.companyId)).data.adminUid == request.auth.uid ||
         (belongsToCompany(request.resource.data.companyId) &&
          (isAdmin() || hasPermission(request.resource.data.companyId, 'canManageUsers'))));
      allow update: if false;
      // The super admin branch is first and unconditional because a purge
      // deletes the company doc, and every other branch needs that doc to
      // exist. Leaving these behind kept resolving a dead company id for any
      // signed-in caller.
      allow delete: if isSuperAdmin() ||
        (isAuthenticated() &&
        resource.data.companyId is string &&
        exists(/databases/$(database)/documents/companies/$(resource.data.companyId)) &&
        (get(/databases/$(database)/documents/companies/$(resource.data.companyId)).data.adminUid == request.auth.uid ||
         (belongsToCompany(resource.data.companyId) && isAdmin())));
    }

    // Companies collection
    match /companies/{companyId} {
      allow read: if canReadCompanyDoc(companyId) || isSuperAdmin();
      // Enumerating tenants is impossible without this: a collection query has
      // no companyId for canReadCompanyDoc to check.
      allow list: if isSuperAdmin();
      // Signing up creates a workspace, so this stays open — but you may only
      // create one you own, and you may not hand yourself a plan or a
      // lifecycle state on the way in.
      allow create: if isAuthenticated()
        && request.resource.data.adminUid == request.auth.uid
        && (!('status' in request.resource.data)
            || request.resource.data.status == 'active')
        && (!('plan' in request.resource.data)
            || request.resource.data.plan.planId == 'max');
      allow update: if isSuperAdmin() ||
        (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageCompanySettings')) &&
          companyPrivilegedFieldsUnchanged()) ||
        (isCompanyCreator(companyId) && companyPermanentJoinCodeUpdateOnly());
      // isCompanyCreator is here so a half-finished signup can clean up after
      // itself: if the user doc write fails, belongsToCompany() is false (the
      // doc is what it reads), leaving the company undeletable and the account
      // stranded. adminUid is server-side truth, so this grants nothing beyond
      // deleting a workspace you created.
      allow delete: if (belongsToCompany(companyId) && isAdmin()) ||
        isCompanyCreator(companyId) ||
        isSuperAdmin();

      // Members subcollection — server-side truth for "who belongs to this
      // workspace".
      //
      // WHY THIS EXISTS: membership is currently proved by companyMemberships
      // on the user's own doc, which the client writes itself
      // (AuthService.joinCompanyByCode / createAdditionalCompany). That is
      // self-written data authorising itself: append a membership for any
      // workspace, switch companyId to it, and belongsToCompany() passes.
      //
      // A member doc cannot be forged the same way: creating one requires
      // naming a join code that actually maps to this company, and it always
      // lands as 'staff'. Only an admin can change a role afterwards.
      //
      // CUTOVER (not yet done — do NOT skip the order):
      //   1. Deploy these rules (additive; nothing reads members yet).
      //   2. Ship the client build that writes member docs on join/register.
      //   3. Run scripts/migrate_members.js to backfill every existing user.
      //   4. Verify every active user has a member doc, THEN change
      //      belongsToCompany() to:
      //        exists(/databases/$(database)/documents/companies/$(companyId)/members/$(request.auth.uid))
      //      and drop hasMembershipForCompany()'s use of the user doc.
      // Flipping step 4 before step 3 completes locks out every existing user.
      match /members/{memberUid} {
        allow read: if isAuthenticated() &&
          (request.auth.uid == memberUid || belongsToCompany(companyId));

        // Self-serve join: entitlement is proved by the join code, not by
        // anything the user can write about themselves.
        allow create: if isAuthenticated() && request.auth.uid == memberUid
          && request.resource.data.uid == memberUid
          && (
            (request.resource.data.role == 'staff'
              // roleId, not role, is what hasPermission() resolves against, and
              // selfUserUpdateDoesNotEscalate now trusts this doc as the record
              // of what the workspace granted. Pinning it here closes the hop
              // that would otherwise remain: mint a member doc reading
              // role:'staff', roleId:'admin' with a valid join code, then
              // mirror that roleId onto your own user doc as "verified".
              && request.resource.data.get('roleId', 'staff') == 'staff'
              && request.resource.data.joinCode is string
              && exists(/databases/$(database)/documents/joinCodeIndex/$(request.resource.data.joinCode))
              && get(/databases/$(database)/documents/joinCodeIndex/$(request.resource.data.joinCode)).data.companyId == companyId)
            || isCompanyCreator(companyId)
          );

        // Admins may add members directly (staff invite flow) and are the only
        // ones who can change or revoke a role.
        allow create, update, delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageUsers'));
      }

      // Roles subcollection
      match /roles/{roleId} {
        allow read: if belongsToCompany(companyId) || isCompanyCreator(companyId);
        allow create: if isCompanyCreator(companyId) ||
          (belongsToCompany(companyId) &&
           (isAdmin() || hasPermission(companyId, 'canManageRoles')));
        allow update: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageRoles'));
        allow delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageRoles')) &&
          resource.data.isSystem != true;
      }

      // Products subcollection
      match /products/{productId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canAddProducts')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditProducts') ||
           hasPermission(companyId, 'canStockIn') ||
           hasPermission(companyId, 'canStockOut') ||
           hasPermission(companyId, 'canDamage') ||
           hasPermission(companyId, 'canTransfer') ||
           hasPermission(companyId, 'canAdjustStock') ||
           hasPermission(companyId, 'canHoldStock') ||
           hasPermission(companyId, 'canReleaseStock') ||
           hasPermission(companyId, 'canBulkStockIn') ||
           hasPermission(companyId, 'canBulkEdit') ||
           hasPermission(companyId, 'canImport') ||
           hasPermission(companyId, 'canConfirmSalesOrders') ||
           hasPermission(companyId, 'canDispatchSalesOrders') ||
           hasPermission(companyId, 'canCancelSalesOrders') ||
           hasPermission(companyId, 'canReceivePurchaseOrders') ||
           hasPermission(companyId, 'canProcessReturns')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeleteProducts')));
      }

      // Categories subcollection
      match /categories/{categoryId} {
        allow read: if belongsToCompany(companyId);
        allow create, update, delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageCategories'));
      }

      // Transactions subcollection
      match /transactions/{transactionId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() ||
           hasPermission(companyId, 'canStockIn') ||
           hasPermission(companyId, 'canStockOut') ||
           hasPermission(companyId, 'canDamage') ||
           hasPermission(companyId, 'canTransfer') ||
           hasPermission(companyId, 'canAdjustStock') ||
           hasPermission(companyId, 'canBulkStockIn') ||
           hasPermission(companyId, 'canHoldStock') ||
           hasPermission(companyId, 'canReleaseStock') ||
           hasPermission(companyId, 'canConfirmSalesOrders') ||
           hasPermission(companyId, 'canDispatchSalesOrders') ||
           hasPermission(companyId, 'canCancelSalesOrders')));
        allow update, delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) && isAdmin());
      }

      // Stock Holds subcollection
      match /stockHolds/{holdId} {
        allow read: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canViewStockHolds'));
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() ||
           hasPermission(companyId, 'canHoldStock') ||
           hasPermission(companyId, 'canConfirmSalesOrders')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() ||
           hasPermission(companyId, 'canReleaseStock') ||
           hasPermission(companyId, 'canHoldStock') ||
           hasPermission(companyId, 'canConfirmSalesOrders') ||
           hasPermission(companyId, 'canEditSalesOrders') ||
           hasPermission(companyId, 'canDispatchSalesOrders') ||
           hasPermission(companyId, 'canCancelSalesOrders')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) && isAdmin());
      }

      // Vendors subcollection
      match /vendors/{vendorId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canAddVendors')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditVendors')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeleteVendors')));
      }

      // Purchase Orders subcollection
      match /purchaseOrders/{orderId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canCreatePurchaseOrders')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditPurchaseOrders') ||
           hasPermission(companyId, 'canApprovePurchaseOrders') ||
           hasPermission(companyId, 'canReceivePurchaseOrders') ||
           hasPermission(companyId, 'canCancelPurchaseOrders')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeletePurchaseOrders')));
      }

      // Sales Orders subcollection
      match /salesOrders/{orderId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canCreateSalesOrders')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditSalesOrders') ||
           hasPermission(companyId, 'canConfirmSalesOrders') ||
           hasPermission(companyId, 'canDispatchSalesOrders') ||
           hasPermission(companyId, 'canDeliverSalesOrders') ||
           hasPermission(companyId, 'canCancelSalesOrders')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeleteSalesOrders')));
      }

      // Returns subcollection
      match /returns/{returnId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canCreateReturns')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canApproveReturns') ||
           hasPermission(companyId, 'canRejectReturns') ||
           hasPermission(companyId, 'canProcessReturns')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) && isAdmin());
      }

      // Customers subcollection
      match /customers/{customerId} {
        allow read: if belongsToCompany(companyId);
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canAddCustomers')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditCustomers')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeleteCustomers')));
      }

      // Batches subcollection
      match /batches/{batchId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageBatches'));
        allow delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageBatches'));
      }

      // Stock Takes subcollection
      match /stockTakes/{stockTakeId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageStockTakes'));
        allow delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageStockTakes'));
      }

      // Billing sequence counters (invoice # generation; writable by invoice creators)
      match /billingSequences/{seqId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) &&
          (isAdmin() ||
           hasPermission(companyId, 'canCreateInvoices') ||
           hasPermission(companyId, 'canManageCompanySettings'));
        allow delete: if false;
      }

      // Invoices subcollection
      match /invoices/{invoiceId} {
        allow read: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canViewInvoices'));
        allow create: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canCreateInvoices')));
        allow update: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canEditInvoices') ||
           hasPermission(companyId, 'canRecordPayments')));
        allow delete: if companyActive(companyId) &&
          (belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canDeleteInvoices')));
      }

      // Audit Logs subcollection (append-only, no edits/deletes)
      match /auditLogs/{logId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }

      // In-app Notifications subcollection
      match /notifications/{notifId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId);
        // Company-wide alerts with no per-user owner: any member may mark one
        // read. Deleting is destructive, so keep that to admins.
        allow update: if belongsToCompany(companyId);
        allow delete: if belongsToCompany(companyId) && isAdmin();
      }

      // Price History subcollection (append-only)
      match /priceHistory/{historyId} {
        allow read: if belongsToCompany(companyId);
        allow create: if belongsToCompany(companyId) && request.resource.data.changedBy == request.auth.uid;
        allow update, delete: if false;
      }

      // Warehouse Zones subcollection
      match /warehouseZones/{zoneId} {
        allow read: if belongsToCompany(companyId);
        allow create, update: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageWarehouseZones'));
        allow delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageWarehouseZones'));
      }

      // Invite codes subcollection
      match /invites/{inviteId} {
        allow get: if isAuthenticated();
        allow list: if belongsToCompany(companyId) && (isAdmin() || hasPermission(companyId, 'canManageUsers'));
        allow create: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageUsers'));
        allow update, delete: if belongsToCompany(companyId) &&
          (isAdmin() || hasPermission(companyId, 'canManageUsers'));
      }

      // Super admin: read everything under a company, and delete (purge only).
      //
      // Rules OR together, so this grants without weakening any rule above —
      // and being a single scoped block it stays auditable, rather than
      // sprinkling isSuperAdmin() through forty allow clauses. It also sits
      // outside companyActive(), which is deliberate: a suspension has to be
      // liftable.
      //
      // create/update are deliberately NOT granted. The platform admin's write
      // powers are lifecycle only — plan and status, which are fields on the
      // company doc and covered by its own `allow update: if isSuperAdmin()`
      // above. This is also what makes the read-only workspace inspector a real
      // control rather than a UI convention: a write that slips past the
      // view-only permission map is denied by the server.
      match /{document=**} {
        allow read, delete: if isSuperAdmin();
      }

      // In-app feedback subcollection (append-only; any member may submit,
      // only admins/owners may review).
      match /feedback/{feedbackId} {
        allow read: if belongsToCompany(companyId) && isAdmin();
        allow create: if belongsToCompany(companyId);
        allow update, delete: if false;
      }
    }
  }
}
